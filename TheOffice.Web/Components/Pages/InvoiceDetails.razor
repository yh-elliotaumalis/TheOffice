@page "/invoice/{Id:int}"
 
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using TheOffice.Application.Interfaces.Services
@using TheOffice.Domain.Entities
 
@inject IInvoiceService InvoiceService
@inject IConfiguration Configuration
 
@attribute [Authorize(Roles = "Admin,Employee,Customer")]
 
<PageTitle>Invoice</PageTitle>
 
<main class="invoice-page">
    @if (isLoading)
    {
        <p>Loading invoice...</p>
    }
    else if (errorMessage != "")
    {
        <p class="text-danger">@errorMessage</p>
    }
    else if (invoice == null)
    {
        <h1>Invoice not found.</h1>
    }
    else
    {
        <article class="invoice">
            <header class="invoice-header">
                <div class="invoice-brand">
                    <span class="invoice-brand-mark" aria-hidden="true">
                        WM
                    </span>
 
                    <strong>@companyName</strong>
                </div>
 
                <div>
                    <h1>Invoice</h1>
 
                    <p>
                        <strong>Invoice number:</strong>
                        @invoice.InvoiceNumber
                    </p>
                </div>
            </header>
 
            <div class="invoice-parties">
                <section>
                    <h2>Company</h2>
                    <p>@companyName</p>
                </section>
 
                <section>
                    <h2>Customer</h2>
                    <p>@(invoice.Customer?.Name ?? "Customer not found")</p>
                    <p>@invoice.Customer?.Address</p>
                    <p>@invoice.Customer?.Email</p>
                </section>
            </div>
 
            <section class="invoice-dates">
                <h2>Dates</h2>
 
                <p>
                    <strong>Invoice date:</strong>
                    @invoice.DateSent.ToString("yyyy-MM-dd")
                </p>
 
                <p>
                    <strong>Due date:</strong>
                    @invoice.DeadLine.ToString("yyyy-MM-dd")
                </p>
 
                <p>
                    <strong>Status:</strong>
                    @(invoice.IsPaid ? "Paid" : "Unpaid")
                </p>
            </section>
 
            <section class="invoice-total">
                <h2>Amount due</h2>
 
                <p>
                    @invoice.TotalAmount.ToString("C2", swedishCulture)
                </p>
            </section>
 
            <section class="invoice-payment">
                <h2>Payment details</h2>
 
                <p>
                    <strong>
                        @(isTestBankgiro ? "Bankgiro (test):" : "Bankgiro:")
                    </strong>
                    @bankgiro
                </p>
 
                <p>
                    <strong>Payment reference:</strong>
                    @invoice.InvoiceNumber
                </p>
            </section>
 
            <footer class="invoice-footer">
                <p>@standardText</p>
            </footer>
        </article>
    }
</main>
 
@code {
    [Parameter]
    public int Id { get; set; }
 
    private Invoice? invoice;
 
    private CultureInfo swedishCulture = new CultureInfo("sv-SE");
 
    private bool isLoading = true;
    private string errorMessage = "";
 
    private string companyName = "Webbyrån Måsvingen";
    private string bankgiro = "";
    private bool isTestBankgiro;
 
    private string standardText =
        "Thank you for your business! Please use the invoice number as the payment reference.";
 
    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        errorMessage = "";
        invoice = null;
 
        bankgiro = Configuration["Invoice:Bankgiro"] ?? "";
 
        isTestBankgiro = string.IsNullOrWhiteSpace(bankgiro);
 
        if (isTestBankgiro)
        {
            bankgiro = "000-0000";
        }
 
        try
        {
            invoice = await InvoiceService.GetByIdAsync(Id);
        }
        catch (Exception)
        {
            errorMessage = "Could not load the invoice.";
        }
        finally
        {
            isLoading = false;
        }
    }
}