@page "/billing-page"
 
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using TheOffice.Application.Interfaces.Services
@using TheOffice.Domain.Entities
 
@inject IInvoiceService InvoiceService
 
@attribute [Authorize(Roles = "Admin,Employee,Customer")]
 
<PageTitle>Invoices</PageTitle>
 
<h1>Invoices</h1>
 
@if (isLoading)
{
    <p>Loading invoices...</p>
}
else if (errorMessage != "")
{
    <p class="text-danger">@errorMessage</p>
}
else
{
    <p class="fs-4 fw-bold">
        Total: @totalAmount.ToString("C2", swedishCulture)
    </p>
 
    <AuthorizeView Roles="Admin">
        <p>
            <a class="btn btn-primary" href="create-invoice">
                Create invoice
            </a>
        </p>
    </AuthorizeView>
 
    <form class="row g-3 mb-4"
          @onsubmit="ApplyFilters"
          @onsubmit:preventDefault>
        <div class="col-md-3">
            <label for="invoice-from-date" class="form-label">
                Start date
            </label>
 
            <input id="invoice-from-date"
                   type="date"
                   class="form-control"
                   @bind="fromDate"
                   required />
        </div>
 
        <div class="col-md-3">
            <label for="invoice-to-date" class="form-label">
                End date
            </label>
 
            <input id="invoice-to-date"
                   type="date"
                   class="form-control"
                   @bind="toDate"
                   required />
        </div>
 
        <div class="col-md-3">
            <label for="invoice-status" class="form-label">
                Payment status
            </label>
 
            <select id="invoice-status"
                    class="form-select"
                    @bind="paymentStatus">
                <option value="All">All</option>
                <option value="Paid">Paid</option>
                <option value="Unpaid">Unpaid</option>
            </select>
        </div>
 
        <div class="col-md-3">
            <label for="invoice-search" class="form-label">
                Search by invoice number, customer or project
            </label>
 
            <input id="invoice-search"
                   type="search"
                   class="form-control"
                   @bind="searchText" />
        </div>
 
        <div class="col-12">
            <button type="submit" class="btn btn-primary">
                Search
            </button>
        </div>
    </form>
 
    @if (filterMessage != "")
    {
        <p class="text-danger">@filterMessage</p>
    }
    else if (filteredInvoices.Count == 0)
    {
        <p>No invoices match your search.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th scope="col">Invoice number</th>
                        <th scope="col">Customer</th>
                        <th scope="col">Invoice date</th>
                        <th scope="col">Due date</th>
                        <th scope="col">Amount</th>
                        <th scope="col">Status</th>
                        <th scope="col">View</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var invoice in filteredInvoices)
                    {
                        <tr>
                            <td>@invoice.InvoiceNumber</td>
 
                            <td>
                                @(invoice.Customer?.Name ?? "Customer not found")
                            </td>
 
                            <td>
                                @invoice.DateSent.ToString("yyyy-MM-dd")
                            </td>
 
                            <td>
                                @invoice.DeadLine.ToString("yyyy-MM-dd")
                            </td>
 
                            <td>
                                @invoice.TotalAmount.ToString(
                                    "C2", swedishCulture)
                            </td>
 
                            <td>
                                @(invoice.IsPaid ? "Paid" : "Unpaid")
                            </td>
 
                            <td>
                                <a href="@($"invoice/{invoice.Id}")">
                                    View invoice
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
 
@code {
    private List<Invoice> invoices = new List<Invoice>();
    private List<Invoice> filteredInvoices = new List<Invoice>();
 
    private CultureInfo swedishCulture = new CultureInfo("sv-SE");
 
    private DateOnly fromDate =
        new DateOnly(DateTime.Today.Year, DateTime.Today.Month, 1);
 
    private DateOnly toDate = DateOnly.FromDateTime(DateTime.Today);
 
    private string paymentStatus = "All";
    private string searchText = "";
    private string filterMessage = "";
    private string errorMessage = "";
 
    private decimal totalAmount;
    private bool isLoading = true;
 
    protected override async Task OnInitializedAsync()
    {
        try
        {
            invoices = (await InvoiceService.GetAllAsync()).ToList();
 
            ApplyFilters();
        }
        catch (Exception)
        {
            errorMessage = "Could not load the invoices.";
        }
        finally
        {
            isLoading = false;
        }
    }
 
    private void ApplyFilters()
    {
        filterMessage = "";
        filteredInvoices = new List<Invoice>();
        totalAmount = 0;
 
        if (fromDate > toDate)
        {
            filterMessage =
                "The start date cannot be after the end date.";
 
            return;
        }
 
        var matchingInvoices = invoices.Where(invoice =>
            invoice.DateSent >= fromDate &&
            invoice.DateSent <= toDate);
 
        if (paymentStatus == "Paid")
        {
            matchingInvoices = matchingInvoices.Where(invoice =>
                invoice.IsPaid);
        }
        else if (paymentStatus == "Unpaid")
        {
            matchingInvoices = matchingInvoices.Where(invoice =>
                !invoice.IsPaid);
        }
 
        var search = searchText.Trim();
 
        if (search != "")
        {
            matchingInvoices = matchingInvoices.Where(invoice =>
                invoice.InvoiceNumber.Contains(
                    search, StringComparison.OrdinalIgnoreCase) ||
                (invoice.Customer?.Name.Contains(
                    search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (invoice.Project?.Name.Contains(
                    search, StringComparison.OrdinalIgnoreCase) ?? false));
        }
 
        filteredInvoices = matchingInvoices
            .OrderByDescending(invoice => invoice.DateSent)
            .ThenByDescending(invoice => invoice.Id)
            .ToList();
 
        totalAmount = filteredInvoices.Sum(invoice =>
            invoice.TotalAmount);
    }
}