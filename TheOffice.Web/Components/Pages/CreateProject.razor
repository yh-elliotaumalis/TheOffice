@page "/create-project"
@rendermode InteractiveServer
@using TheOffice.Application.Interfaces.Services
@using TheOffice.Domain.Entities
@inject ICustomerService CustomerService
@inject IProjectService ProjectService
@inject NavigationManager NavigationManager

<div class="container mt-4" style="display: flex; flex-direction: column; align-items: center; justify-content: center;">
    <EditForm Model="newProject" OnValidSubmit="SaveProject" class="card p-4 shadow-sm" style="width: 100%; max-width: 550px;">

        <h4 class="mb-3">Create New Project</h4>
        <DataAnnotationsValidator />

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <div class="mb-3">
            <label class="form-label fw-bold">Project Name</label>
            <InputText @bind-Value="newProject.Name" class="form-control" placeholder="Example. Webbplats Måsvingen" />
            <ValidationMessage For="@(() => newProject.Name)" class="text-danger" />
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Customer</label>
            <InputSelect @bind-Value="newProject.CustomerId" class="form-select">
                <option value="0">-- Choose Customer --</option>
                @foreach (var customer in customers)
                {
                    <option value="@customer.Id">@customer.Name</option>
                }
            </InputSelect>
            <ValidationMessage For="@(() => newProject.CustomerId)" class="text-danger" />
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-success px-4">Create</button>
            <button type="button" class="btn btn-secondary px-4" @onclick="Cancel">Cancel</button>
        </div>
    </EditForm>
</div>

@code {
    private Project newProject = new();
    private List<Customer> customers = new();
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            customers = (await CustomerService.GetAllAsync()).ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not retrieve customers: {ex.Message}";
        }
    }

    private async Task SaveProject()
    {
        try
        {
            errorMessage = null;

            if (newProject.CustomerId == 0)
            {
                errorMessage = "You must select a client for the project..";
                return;
            }

            await ProjectService.AddAsync(newProject);
            NavigationManager.NavigateTo("/client-project");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error while saving: {ex.Message}";
        }
    }

    private void Cancel()
    {
        NavigationManager.NavigateTo("/client-project");
    }
}