@page "/customers/{Id:int}"
@using System.ComponentModel.DataAnnotations
@using TheOffice.Application.Interfaces.Services
@using TheOffice.Domain.Entities
@inject ICustomerService CustomerService
@inject NavigationManager NavigationManager

<PageTitle>@(customer?.Name ?? "Kund")</PageTitle>

@if (isLoading)
{
    <p>Laddar kund...</p>
}
else if (customer == null)
{
    <h1>Kunden hittades inte.</h1>
}
else
{
    <h1>@customer.Name</h1>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <p class="text-danger">@errorMessage</p>
    }

    @if (isEditing)
    {
        <EditForm Model="input" OnValidSubmit="SaveCustomer" FormName="edit-customer">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label for="customer-name">Namn</label>
                <InputText id="customer-name" class="form-control" @bind-Value="input.Name" />
                <ValidationMessage For="() => input.Name" class="text-danger" />
            </div>

            <div class="mb-3">
                <label for="customer-address">Adress</label>
                <InputText id="customer-address" class="form-control" @bind-Value="input.Address" />
                <ValidationMessage For="() => input.Address" class="text-danger" />
            </div>

            <div class="mb-3">
                <label for="customer-phone">Telefon</label>
                <InputText id="customer-phone" type="tel" class="form-control" @bind-Value="input.PhoneNumber" />
                <ValidationMessage For="() => input.PhoneNumber" class="text-danger" />
            </div>

            <div class="mb-3">
                <label for="customer-email">E-post</label>
                <InputText id="customer-email" type="email" class="form-control" @bind-Value="input.Email" />
                <ValidationMessage For="() => input.Email" class="text-danger" />
            </div>

            <div class="mb-3">
                <label for="customer-notes">Anteckningar om kundens behov</label>
                <InputTextArea id="customer-notes" class="form-control" rows="4" @bind-Value="input.Notes" />
            </div>

            <button type="submit" class="btn btn-primary" disabled="@isBusy">Spara</button>
            <button type="button" class="btn btn-secondary" disabled="@isBusy" @onclick="CancelEditing">Avbryt</button>
        </EditForm>
    }
    else
    {
        <p><strong>Adress:</strong> @customer.Address</p>
        <p><strong>Telefon:</strong> @customer.PhoneNumber</p>
        <p><strong>E-post:</strong> @customer.Email</p>

        <h2>Anteckningar</h2>
        @if (string.IsNullOrWhiteSpace(customer.Notes))
        {
            <p>Inga anteckningar.</p>
        }
        else
        {
            <p style="white-space: pre-wrap">@customer.Notes</p>
        }

        <button type="button" class="btn btn-primary" disabled="@isBusy" @onclick="StartEditing">Redigera</button>
        <button type="button" class="btn btn-danger" disabled="@isBusy" @onclick="AskToDelete">Ta bort</button>
    }

    @if (confirmDelete)
    {
        <p class="mt-3">Vill du ta bort kunden?</p>
        <button type="button" class="btn btn-danger" disabled="@isBusy" @onclick="DeleteCustomer">Ja, ta bort</button>
        <button type="button" class="btn btn-secondary" disabled="@isBusy" @onclick="CancelDelete">Avbryt</button>
    }

    <h2 class="mt-3">Projekt</h2>
    @if (customer.Projects.Count == 0)
    {
        <p>Inga projekt hittades.</p>
    }
    else
    {
        <ul>
            @foreach (var project in customer.Projects)
            {
                <li>@project.Name</li>
            }
        </ul>
    }
}

<p class="mt-3"><a href="customers">Tillbaka till kundlistan</a></p>

@code {
    [Parameter]
    public int Id { get; set; }

    private Customer? customer;
    private CustomerInput input = new CustomerInput();
    private bool isLoading = true;
    private bool isEditing = false;
    private bool isBusy = false;
    private bool confirmDelete = false;
    private string errorMessage = "";

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        isEditing = false;
        confirmDelete = false;
        errorMessage = "";
        customer = await CustomerService.GetByIdAsync(Id);
        isLoading = false;
    }

    private void StartEditing()
    {
        if (customer == null) return;

        input = new CustomerInput
        {
            Name = customer.Name,
            Address = customer.Address,
            PhoneNumber = customer.PhoneNumber,
            Email = customer.Email,
            Notes = customer.Notes
        };

        errorMessage = "";
        confirmDelete = false;
        isEditing = true;
    }

    private void CancelEditing()
    {
        isEditing = false;
    }

    private async Task SaveCustomer()
    {
        if (customer == null || isBusy) return;

        isBusy = true;

        try
        {
            customer.Name = input.Name.Trim();
            customer.Address = input.Address.Trim();
            customer.PhoneNumber = input.PhoneNumber.Trim();
            customer.Email = input.Email.Trim();
            customer.Notes = input.Notes.Trim();

            await CustomerService.UpdateAsync(customer);
            isEditing = false;
        }
        finally
        {
            isBusy = false;
        }
    }

    private void AskToDelete()
    {
        errorMessage = "";
        confirmDelete = true;
    }

    private void CancelDelete()
    {
        confirmDelete = false;
    }

    private async Task DeleteCustomer()
    {
        if (customer == null || isBusy) return;

        isBusy = true;

        try
        {
            await CustomerService.DeleteAsync(customer.Id);
            NavigationManager.NavigateTo("/customers");
        }
        catch (InvalidOperationException exception)
        {
            errorMessage = exception.Message;
            confirmDelete = false;
        }
        finally
        {
            isBusy = false;
        }
    }

    private class CustomerInput
    {
        [Required(ErrorMessage = "Ange kundens namn.")]
        public string Name { get; set; } = "";

        [Required(ErrorMessage = "Ange kundens adress.")]
        public string Address { get; set; } = "";

        [Required(ErrorMessage = "Ange kundens telefonnummer.")]
        [Phone(ErrorMessage = "Ange ett giltigt telefonnummer.")]
        public string PhoneNumber { get; set; } = "";

        [Required(ErrorMessage = "Ange kundens e-postadress.")]
        [EmailAddress(ErrorMessage = "Ange en giltig e-postadress.")]
        public string Email { get; set; } = "";

        public string Notes { get; set; } = "";
    }
}
