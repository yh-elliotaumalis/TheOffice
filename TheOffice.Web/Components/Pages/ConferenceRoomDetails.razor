@page "/conference-room/{Id:int}"

<PageTitle>Conference Room</PageTitle>

<div class="container">
    @if(isLoading)
    {
        <p>Loading conference room details...</p>
    }
    else if (conferenceRoom is null)
    {
        <p>Conference room not found.</p>
    }
    else
    {
        <h2 class="mb-3">@conferenceRoom.Name</h2>

        <div class="mb-3">
            <button class="btn btn-primary" @onclick="ToggleEditConferenceRoom">
                @if (isEditing)
                {
                    <span>Cancel</span>
                }
                else
                {
                    <span>Edit Conference Room</span>
                }
            </button>
            <button class="btn btn-danger" @onclick="OpenDeleteConfirmation">Delete</button>
            <button class="btn btn-success" @onclick="ToggleBookMeeting">
                @(isBooking ? "Cancel booking" : "Book meeting")
            </button>
        </div>

        @if (bookingSuccess)
        {
            <div class="alert alert-success">Meeting booked!</div>
        }

        @if (isBooking)
        {
            <EditForm Model="newBooking" OnValidSubmit="CreateBooking" FormName="create-booking" class="mb-3">
                <DataAnnotationsValidator />

                @if (bookingError is not null)
                {
                    <div class="alert alert-danger">@bookingError</div>
                }

                <div class="mb-3">
                    <label for="booking-topic" class="form-label">Topic</label>
                    <InputText id="booking-topic" class="form-control" @bind-Value="newBooking.Description" />
                    <ValidationMessage For="() => newBooking.Description" class="text-danger" />
                </div>

                <div class="row mb-3">
                    <div class="col-md-4">
                        <label for="booking-date" class="form-label">Date</label>
                        <InputDate id="booking-date" class="form-control" @bind-Value="newBooking.Date" />
                        <ValidationMessage For="() => newBooking.Date" class="text-danger" />
                    </div>
                    <div class="col-md-4">
                        <label for="booking-start" class="form-label">Start</label>
                        <InputDate Type="InputDateType.Time" id="booking-start" class="form-control" @bind-Value="newBooking.StartTime" />
                        <ValidationMessage For="() => newBooking.StartTime" class="text-danger" />
                    </div>
                    <div class="col-md-4">
                        <label for="booking-end" class="form-label">End</label>
                        <InputDate Type="InputDateType.Time" id="booking-end" class="form-control" @bind-Value="newBooking.EndTime" />
                        <ValidationMessage For="() => newBooking.EndTime" class="text-danger" />
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label for="booking-employee" class="form-label">Employee</label>
                        <InputSelect id="booking-employee" class="form-select" @bind-Value="newBooking.EmployeeId">
                            <option value="">-- Select employee --</option>
                            @foreach (var employee in employees)
                            {
                                <option value="@employee.Id">@employee.FullName</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => newBooking.EmployeeId" class="text-danger" />
                    </div>
                    <div class="col-md-6">
                        <label for="booking-customer" class="form-label">Customer</label>
                        <InputSelect id="booking-customer" class="form-select" @bind-Value="newBooking.CustomerId">
                            <option value="">-- Select customer --</option>
                            @foreach (var customer in customers)
                            {
                                <option value="@customer.Id">@customer.Name</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => newBooking.CustomerId" class="text-danger" />
                    </div>
                </div>

                <button type="submit" class="btn btn-success" disabled="@isSavingBooking">Book</button>
            </EditForm>
        }

        @if (success)
        {
            <div class="alert alert-success">Conference room updated successfully!</div>
        }

        @if(isEditing)
        {
            @if (errorMessage is not null)
            {
                <div class="alert alert-danger">@errorMessage</div>
            }

            <EditForm Model="editConferenceRoom" OnValidSubmit="UpdateConferenceRoom" class="mb-3">
                <DataAnnotationsValidator />
                <ValidationSummary />
                @if(errorMessage is not null)
                {
                    <div class="alert alert-danger">@errorMessage</div>
                }
                <div class="mb-3">
                    <label for="room-name" class="form-label">Conference Room Name</label>
                    <InputText id="room-name" class="form-control" @bind-Value="editConferenceRoom.Name" />
                </div>
                <button type="submit" class="btn btn-success">Update</button>
            </EditForm>
        }

        @if(showDeleteModal)
        {
            <div class="modal show fade d-block" tabindex="-1" role="dialog">
                <div class="modal-dialog" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Confirm Deletion</h5>
                        </div>
                        <div class="modal-body">
                            <p>Are you sure you want to delete this conference room?</p>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-danger" @onclick="DeleteConferenceRoom">Delete</button>
                            <button type="button" class="btn btn-secondary" data-dismiss="modal" @onclick="CloseDeleteConfirmation">Close</button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-backdrop fade show"></div>
        }

        <h4 class="mb-2">Bookings</h4>
        <table class="table">
            <thead>
                <tr>
                    <th>Start Time</th>
                    <th>End Time</th>
                    <th>Topic</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var booking in conferenceRoom.Bookings.OrderBy(b => b.StartTime))
                {
                    <tr>
                        <td>@booking.StartTime</td>
                        <td>@booking.EndTime</td>
                        <td>@booking.Description</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>