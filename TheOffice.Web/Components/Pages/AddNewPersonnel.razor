@page "/addnewpersonnel-page"
@using TheOffice.Application.Interfaces.Services
@using TheOffice.Domain.Entities
@using TheOffice.Web.Data
@inject ApplicationDbContext Dbcontext
@inject IEmployeeService EmployeeService
@inject NavigationManager Navigation



<div style="display: flex; flex-direction: column; align-items: center; justify-content: center;">
    <EditForm Model="employee" OnValidSubmit="SaveEmployee" class="card p-4 shadow-sm" style="width: 45%;">
        <div class="mb-3">
            <label class="form-label font-weight-bold">Full Name</label>
            <InputText @bind-Value="employee.FullName" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label font-weight-bold">Phone Number</label>
            <InputText @bind-Value="employee.Number" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label font-weight-bold">Email</label>
            <InputText @bind-Value="employee.Email" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label font-weight-bold">Address</label>
            <InputText @bind-Value="employee.Address" class="form-control" />
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-success">Add</button>
            <button type="button" class="btn btn-secondary" @onclick="Cancel">Cancel</button>
        </div>
    </EditForm>
</div>


@code {
    private Employee? employee = new Employee();

    private async Task SaveEmployee()
    {
        if (employee != null)
        {
            await EmployeeService.AddAsync(employee);
            Navigation.NavigateTo("/personnelregister-page");
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/personnelregister-page");
    }
}