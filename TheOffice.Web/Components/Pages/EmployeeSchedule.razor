@page "/employee-schedule"
@attribute [Authorize(Roles = "Admin,Employee")]
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using TheOffice.Application.Interfaces.Repositories
@using TheOffice.Domain.Entities
@using TheOffice.Web.Data
@inject AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer
@inject IEmployeeAbsenceRepository AbsenceRepo
@inject IEmployeeRepository EmployeeRepo
@inject UserManager<ApplicationUser> _userManager

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Schedule for @employeeName</h3>

    <div class="d-flex align-items-center gap-2">
        <button class="btn btn-outline-primary btn-sm" @onclick="PreviousWeek">&laquo; Previous</button>
        <button class="btn btn-primary btn-sm" @onclick="CurrentWeek">Current Week</button>
        <button class="btn btn-outline-primary btn-sm" @onclick="NextWeek">Next &raquo;</button>
        <span class="fw-bold ms-2">Week @currentWeekNumber, @currentDate.Year</span>
    </div>
</div>

<div class="table-responsive mt-3">
    <table class="table table-bordered align-middle text-center">
        <thead class="table-light">
            <tr>
                <th style="width: 20%;">Day</th>
                <th>08:00 - 10:00</th>
                <th>10:00 - 12:00</th>
                <th>12:00 - 13:00</th>
                <th>13:00 - 15:00</th>
                <th>15:00 - 16:00</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var day in weekDays)
            {
                var absence = absences?.FirstOrDefault(a => day.Date >= a.StartDate.Date && day.Date <= a.EndDate.Date);

                <tr>
                    <td class="fw-bold bg-light text-start">
                        @day.ToString("dddd, MMM d", CultureInfo.InvariantCulture)
                    </td>

                    @if (absence != null)
                    {
                        <td colspan="5" class="bg-warning-subtle fw-bold">
                            @absence.Type - @absence.Description
                        </td>
                    }
                    else
                    {
                        <td></td>
                        <td></td>
                        <td class="bg-light text-muted">Lunch Break</td>
                        <td></td>
                        <td></td>
                    }
                </tr>
            }
        </tbody>
    </table>

    <div style="display: flex; justify-content: space-between;">
        <p class="fw-bold mt-2">Total Hours: @TotalWeekHours h</p>
        <NavLink style="padding: 0.7rem 0.4rem; background-color: green; border-radius: 0.6rem; text-decoration: none; color: white;" href="@($"/report-absence")">Absence</NavLink>
    </div>
</div>

@code {
    private string employeeName = "Guest";
    private DateTime currentDate = DateTime.Today;
    private List<EmployeeAbsence> absences = new();
    private List<DateTime> weekDays = new();
    private int currentWeekNumber;
    private int TotalWeekHours => weekDays.Count * 7;


    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var authUser = authState.User;
        var user = await _userManager.GetUserAsync(authState.User);
        var currentEmployeeId = user?.EmployeeId;

        if (currentEmployeeId == null)
        {
            return;
        }

        var employee = await EmployeeRepo.GetByIdAsync(currentEmployeeId.Value);

        if (employee is not null)
        {
            employeeName = employee.FullName;

            absences = (await AbsenceRepo.GetAllAsync())
                .Where(a => a.EmployeeId == employee.Id)
                .ToList();
        }

        LoadWeek();
    }

    private void LoadWeek()
    {
        int diff = (7 + (currentDate.DayOfWeek - DayOfWeek.Monday)) % 7;
        DateTime monday = currentDate.AddDays(-1 * diff).Date;

        weekDays = Enumerable.Range(0, 5).Select(i => monday.AddDays(i)).ToList();
        currentWeekNumber = ISOWeek.GetWeekOfYear(monday);
    }

    private void PreviousWeek()
    {
        currentDate = currentDate.AddDays(-7);
        LoadWeek();
    }

    private void NextWeek()
    {
        currentDate = currentDate.AddDays(7);
        LoadWeek();
    }

    private void CurrentWeek()
    {
        currentDate = DateTime.Today;
        LoadWeek();
    }
}