@page "/timereport-page"

@attribute [Authorize(Roles = "Admin,Employee")]

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using TheOffice.Application.Interfaces.Services
@using TheOffice.Domain.Entities
@using TheOffice.Web.Data
@using TimeReportEntry = TheOffice.Domain.Entities.TimeReport

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IEmployeeService EmployeeService
@inject IProjectService ProjectService
@inject ITimeReportService TimeReportService
@inject UserManager<ApplicationUser> _userManager

<PageTitle>Time reporting</PageTitle>

<h1>Record time on a project</h1>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <p class="text-danger">@errorMessage</p>
}

@if (isLoading)
{
    <p>Loading...</p>
}
else if (employee != null && projects.Count == 0)
{
    <p>There are no projects available for time reporting.</p>
}
else if (employee != null)
{
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <p class="text-success" role="status">
            @successMessage
        </p>
    }

    <EditForm Model="input"
              OnValidSubmit="SaveTimeReport"
              FormName="project-time-report">
        <DataAnnotationsValidator />

        <fieldset disabled="@(isSaving || isSearching)">
            <div class="mb-3">
                <label for="project" class="form-label">
                    Customer project
                </label>

                <InputSelect id="project"
                             class="form-select"
                             @bind-Value="input.ProjectId"
                             @bind-Value:after="ProjectChanged">
                    <option value="0">Select a project</option>

                    @foreach (var project in projects)
                    {
                        <option value="@project.Id">
                            @project.Name
                        </option>
                    }
                </InputSelect>

                <ValidationMessage For="() => input.ProjectId" />
            </div>

            <div class="mb-3">
                <label for="date" class="form-label">
                    Date
                </label>

                <InputDate id="date"
                           class="form-control"
                           @bind-Value="input.Date" />

                <ValidationMessage For="() => input.Date" />
            </div>

            <div class="mb-3">
                <label for="hours" class="form-label">
                    Hours worked
                </label>

                <InputNumber id="hours"
                             class="form-control"
                             @bind-Value="input.Hours"
                             min="0.01"
                             step="0.01" />

                <ValidationMessage For="() => input.Hours" />
            </div>

            <div class="mb-3">
                <label for="description" class="form-label">
                    Work description
                </label>

                <InputTextArea id="description"
                               class="form-control"
                               rows="3"
                               @bind-Value="input.Description" />

                <ValidationMessage For="() => input.Description" />
            </div>

            <button type="submit" class="btn btn-primary">
                Save
            </button>
        </fieldset>
    </EditForm>

    @if (input.ProjectId > 0)
    {
        <h2 class="mt-4">My time entries for this project</h2>

        var projectReports = timeReports
            .Where(report => report.ProjectId == input.ProjectId)
            .OrderByDescending(report => report.Date)
            .ToList();

        @if (projectReports.Count == 0)
        {
            <p>No time entries were found for this project.</p>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Hours</th>
                        <th>Work description</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var report in projectReports)
                    {
                        <tr>
                            <td>
                                @report.Date.ToString("yyyy-MM-dd")
                            </td>
                            <td>@report.Hours</td>
                            <td>@report.Description</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
}

@if (!isLoading && (employee != null || isAdmin))
{
    <h2 class="mt-4">View working hours</h2>

    <fieldset disabled="@(isSearching || isSaving)">
        @if (isAdmin)
        {
            <div class="mb-3">
                <label for="report-employee" class="form-label">
                    Employee
                </label>

                <select id="report-employee"
                        class="form-select"
                        @bind="selectedEmployeeId"
                        @bind:after="ClearPeriodReport">
                    <option value="0">Select an employee</option>

                    @foreach (var person in employees)
                    {
                        <option value="@person.Id">
                            @person.FullName
                        </option>
                    }
                </select>
            </div>
        }
        else
        {
            <p>Employee: @employee?.FullName</p>
        }

        <div class="mb-3">
            <label for="report-from" class="form-label">
                Start date
            </label>

            <input id="report-from"
                   type="date"
                   class="form-control"
                   @bind="fromDate"
                   @bind:after="ClearPeriodReport" />
        </div>

        <div class="mb-3">
            <label for="report-to" class="form-label">
                End date
            </label>

            <input id="report-to"
                   type="date"
                   class="form-control"
                   @bind="toDate"
                   @bind:after="ClearPeriodReport" />
        </div>

        <button type="button"
                class="btn btn-primary"
                @onclick="ShowPeriodReport">
            View working hours
        </button>
    </fieldset>

    @if (!string.IsNullOrEmpty(reportErrorMessage))
    {
        <p class="text-danger" role="alert">
            @reportErrorMessage
        </p>
    }

    @if (hasSearched)
    {
        @if (periodReports.Count == 0)
        {
            <p>No working hours were found for this period.</p>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Project</th>
                        <th>Hours</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var report in periodReports)
                    {
                        <tr>
                            <td>
                                @report.Date.ToString("yyyy-MM-dd")
                            </td>
                            <td>@report.Project.Name</td>
                            <td>@report.Hours</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <p>
            <strong>
                Total: @periodReports.Sum(report => report.Hours) hours
            </strong>
        </p>
    }
}

@code {
    private Employee? employee;

    private List<Employee> employees = new List<Employee>();
    private List<Project> projects = new List<Project>();

    private List<TimeReportEntry> timeReports =
        new List<TimeReportEntry>();

    private List<TimeReportEntry> periodReports =
        new List<TimeReportEntry>();

    private TimeReportInput input = new TimeReportInput();

    private int selectedEmployeeId;

    private DateOnly? fromDate =
        new DateOnly(DateTime.Today.Year, DateTime.Today.Month, 1);

    private DateOnly? toDate = DateOnly.FromDateTime(DateTime.Today);

    private bool isAdmin = false;
    private bool isLoading = true;
    private bool isSaving = false;
    private bool isSearching = false;
    private bool hasSearched = false;

    private string errorMessage = "";
    private string successMessage = "";
    private string reportErrorMessage = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authenticationState =
                await AuthenticationStateProvider.GetAuthenticationStateAsync();

            var authUser = authenticationState.User;

            if (authUser.Identity?.IsAuthenticated != true)
            {
                errorMessage = "You must be signed in.";
                return;
            }

            var user = await _userManager.GetUserAsync(authUser);

            if (user == null)
            {
                errorMessage = "User not found.";
                return;
            }

            isAdmin = authUser.IsInRole("Admin");

            employees = (await EmployeeService.GetAllAsync())
                .OrderBy(item => item.FullName)
                .ToList();

            if (user.EmployeeId != null)
            {
                employee = await EmployeeService.GetByIdAsync(
                    user.EmployeeId.Value);
            }

            if (employee == null && !isAdmin)
            {
                errorMessage =
                    "No employee is linked to your account.";

                return;
            }

            if (employee != null)
            {
                selectedEmployeeId = employee.Id;

                projects = (await ProjectService.GetAllAsync()).ToList();

                timeReports = (await TimeReportService.GetAllAsync())
                    .Where(report => report.EmployeeId == employee.Id)
                    .ToList();
            }
        }
        catch (Exception)
        {
            employee = null;
            isAdmin = false;

            errorMessage =
                "Could not load the information. Reload the page and try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ProjectChanged()
    {
        errorMessage = "";
        successMessage = "";
    }

    private void ClearPeriodReport()
    {
        periodReports.Clear();
        hasSearched = false;
        reportErrorMessage = "";
    }

    private async Task ShowPeriodReport()
    {
        if (isSearching)
        {
            return;
        }

        ClearPeriodReport();

        if (fromDate == null || toDate == null)
        {
            reportErrorMessage = "Select a start date and an end date.";
            return;
        }

        if (fromDate.Value > toDate.Value)
        {
            reportErrorMessage =
                "The start date cannot be after the end date.";

            return;
        }

        if (!isAdmin && employee != null)
        {
            selectedEmployeeId = employee.Id;
        }

        if (!employees.Any(item => item.Id == selectedEmployeeId))
        {
            reportErrorMessage = "Select an employee.";
            return;
        }

        isSearching = true;

        try
        {
            periodReports =
                (await TimeReportService.GetByEmployeeAndPeriodAsync(
                    selectedEmployeeId,
                    fromDate.Value,
                    toDate.Value)).ToList();

            hasSearched = true;
        }
        catch (UnauthorizedAccessException exception)
        {
            reportErrorMessage = exception.Message;
        }
        catch (ArgumentException exception)
        {
            reportErrorMessage = exception.Message;
        }
        catch (Exception)
        {
            reportErrorMessage = "Could not load the working hours.";
        }
        finally
        {
            isSearching = false;
        }
    }

    private async Task SaveTimeReport()
    {
        if (employee == null || isSaving || isSearching)
        {
            return;
        }

        errorMessage = "";
        successMessage = "";

        if (!projects.Any(project => project.Id == input.ProjectId) ||
            input.Date == null)
        {
            errorMessage = "Select a project and enter a date.";
            return;
        }

        isSaving = true;

        try
        {
            var timeReport = new TimeReportEntry
            {
                EmployeeId = employee.Id,
                ProjectId = input.ProjectId,
                Date = input.Date.Value,
                Hours = input.Hours,
                Description = input.Description.Trim()
            };

            var savedReport = await TimeReportService.AddAsync(timeReport);

            timeReports.Add(savedReport);

            input = new TimeReportInput
            {
                ProjectId = savedReport.ProjectId,
                Date = savedReport.Date
            };

            successMessage = "The time entry has been saved.";

            if (hasSearched)
            {
                await ShowPeriodReport();
            }
        }
        catch (Exception)
        {
            errorMessage =
                "Could not save the time entry. Reload the page and try again.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private class TimeReportInput
    {
        [Range(1, int.MaxValue, ErrorMessage = "Select a project.")]
        public int ProjectId { get; set; }

        [Required(ErrorMessage = "Enter a date.")]
        public DateOnly? Date { get; set; } =
            DateOnly.FromDateTime(DateTime.Today);

        [Range(
            0.01,
            double.MaxValue,
            ErrorMessage = "Enter a number of hours greater than zero.")]
        public decimal Hours { get; set; }

        [Required(ErrorMessage = "Enter a work description.")]
        public string Description { get; set; } = "";
    }
}
