@page "/conference-rooms"

<PageTitle>Conference Rooms</PageTitle>

<div class="container">
    <h1 class="mb-3">Conference Rooms</h1>
    <div class="mb-2">
        <button class="btn btn-primary mb-3" @onclick="ToggleCreateConferenceRoom">
            @if (isCreating)
            {
                <span>Cancel</span>
            }
            else
            {
                <span>Create Conference Room</span>
            }
        </button>
        @if (success)
        {
            <div class="alert alert-success">Conference room created successfully!</div>
        }
        @if (isCreating)
        {
            @if(errorMessage is not null)
            {
                <div class="alert alert-danger">@errorMessage</div>
            }

            <EditForm Model="newConferenceRoom" OnValidSubmit="CreateConferenceRoom">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="mb-3">
                    <label for="room-name" class="form-label">Conference Room Name</label>
                    <InputText id="room-name" class="form-control" @bind-Value="newConferenceRoom.Name" />
                </div>
                <button type="submit" class="btn btn-success">Create</button>
            </EditForm>
        }
    </div>

    <input class="mb-2 form-control" id="room-search" type="search" @bind="search" @bind:event="oninput" @bind:after="SearchConferenceRooms" placeholder="Search conference rooms" />
    
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Room Name</th>
                <th>Availability</th>
            </tr>
        </thead>
        <tbody>
            @if (conferenceRooms == null)
            {
                <tr>
                    <td colspan="2">Loading conference rooms...</td>
                </tr>
            }
            else if (!conferenceRooms.Any())
            {
                <tr>
                    <td colspan="2">No conference rooms available.</td>
                </tr>
            }
            else
            {
                @foreach (var room in conferenceRooms)
                {
                    <tr>
                        <td>
                            <a href="/conference-room/@room.Id">@room.Name</a>
                        </td>
                        <td>@(IsAvailable(room) ? "Available" : "Unavailable")</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>