@page "/customers"
 
@attribute [Authorize(Roles = "Admin,Employee")]
 
@using Microsoft.AspNetCore.Authorization
@using TheOffice.Application.Interfaces.Services
@using TheOffice.Domain.Entities
 
@inject ICustomerService CustomerService
 
<PageTitle>Customers</PageTitle>
 
<h1>Customers</h1>
 
<div class="mb-3">
    <a class="btn btn-primary" href="customers/create">
        Create customer
    </a>
</div>
 
<label for="customer-search">
    Search by name or customer number
</label>
 
<input id="customer-search"
       type="search"
       class="form-control mb-3"
       @bind="searchText"
       @bind:event="oninput" />
 
@if (isLoading)
{
    <p>Loading customers...</p>
}
else
{
    var filteredCustomers = GetFilteredCustomers();
 
    if (filteredCustomers.Count == 0)
    {
        <p>No customers found.</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">Customer number</th>
                    <th scope="col">Name</th>
                    <th scope="col">Phone number</th>
                    <th scope="col">Email</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var customer in filteredCustomers)
                {
                    <tr>
                        <td>@customer.Id</td>
                        <td>
                            <a href="@($"customers/{customer.Id}")">
                                @customer.Name
                            </a>
                        </td>
                        <td>@customer.PhoneNumber</td>
                        <td>@customer.Email</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}
 
@code {
    private List<Customer> customers = new List<Customer>();
    private string searchText = "";
    private bool isLoading = true;
 
    protected override async Task OnInitializedAsync()
    {
        customers = (await CustomerService.GetAllAsync()).ToList();
 
        isLoading = false;
    }
 
    private List<Customer> GetFilteredCustomers()
    {
        string search = searchText.Trim();
 
        return customers.Where(customer =>
            customer.Name.Contains(
                search, StringComparison.OrdinalIgnoreCase)
            || customer.Id.ToString().Contains(search)).ToList();
    }
}