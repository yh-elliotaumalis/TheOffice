@page "/edit-personnel/{Id:int}"
@using TheOffice.Application.Interfaces.Services
@using TheOffice.Domain.Entities
@using TheOffice.Web.Data
@inject ApplicationDbContext Dbcontext
@inject IEmployeeService EmployeeService
@inject NavigationManager Navigation

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3>Edit Personnel</h3>
</div>

@if (employee == null)
{
    <p><em>Loading employee details...</em></p>
}
else
{
    <div style="display: flex; flex-direction: column; align-items: center; justify-content: center;">
        <EditForm Model="employee" OnValidSubmit="SaveEmployee" class="card p-4 shadow-sm" style="width: 45%;">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label font-weight-bold">Full Name</label>
                <InputText @bind-Value="employee.FullName" class="form-control" />
                <ValidationMessage For="@(() => employee.FullName)" class="text-danger" />
            </div>
            
            <div class="mb-3">
                <label class="form-label font-weight-bold">Social Number</label>
                <InputText @bind-Value="employee.SocialNumber" class="form-control" />
                <ValidationMessage For="@(() => employee.SocialNumber)" class="text-danger" />
            </div>
            
            <div class="mb-3">
                <label class="form-label font-weight-bold">Title</label>
                <InputText @bind-Value="employee.Title" class="form-control" />
                <ValidationMessage For="@(() => employee.Title)" class="text-danger" />
            </div>

            <div class="mb-3">
                <label class="form-label font-weight-bold">Email</label>
                <InputText @bind-Value="employee.Email" class="form-control" />
                <ValidationMessage For="@(() => employee.Email)" class="text-danger" />
            </div>

            <div class="mb-3">
                <label class="form-label font-weight-bold">Phone Number</label>
                <InputText @bind-Value="employee.Number" class="form-control" />
                <ValidationMessage For="@(() => employee.Number)" class="text-danger" />
            </div>

            <div class="mb-3">
                <label class="form-label font-weight-bold">Address</label>
                <InputText @bind-Value="employee.Address" class="form-control" />
                <ValidationMessage For="@(() => employee.Address)" class="text-danger" />
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-success">Save Changes</button>
                <button type="button" class="btn btn-secondary" @onclick="Cancel">Cancel</button>
            </div>
        </EditForm>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Employee? employee;

    protected override async Task OnInitializedAsync()
    {
        employee = await EmployeeService.GetByIdAsync(Id);
    }

    private async Task SaveEmployee()
    {
        if (employee != null)
        {
            await EmployeeService.UpdateAsync(employee);
            Navigation.NavigateTo($"/employee-details/{Id}");
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo($"/employee-details/{Id}");
    }
}