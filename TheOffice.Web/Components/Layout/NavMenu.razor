@implements IDisposable
@inject NavigationManager NavigationManager

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />


<nav class="nav-content align-items-center justify-content-center w-100 px-3">

    <div class="d-flex align-items-center me-auto">
        <div class="nav-item">
            <NavLink class="nav-link fs-6 fw-semibold py-2 px-3 text-nowrap"
                     href=""
                     Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu me-1" aria-hidden="true"></span>
                Home
            </NavLink>
        </div>
    </div>
    <div class="d-flex align-items-center justify-content-center mx-auto gap-1">

        <NavLink class="nav-link fs-6 fw-semibold py-2 px-3 text-nowrap text-white"
                 href="personnelregister-page">
            Personnel Register
        </NavLink>

        <NavLink class="nav-link fs-6 fw-semibold py-2 px-3 text-nowrap text-white"
                 href="customers">
            Customer Register
        </NavLink>

        <NavLink class="nav-link fs-6 fw-semibold py-2 px-3 text-nowrap text-white"
                 href="booking-page">
            Bookings
        </NavLink>

        <NavLink class="nav-link fs-6 fw-semibold py-2 px-3 text-nowrap text-white"
                 href="timereport-page">
            Time Report
        </NavLink>

        <NavLink class="nav-link fs-6 fw-semibold py-2 px-3 text-nowrap text-white"
                 href="billing-page">
            Billing
        </NavLink>

        <NavLink class="nav-link fs-6 fw-semibold py-2 px-3 text-nowrap text-white"
                 href="contact">
            Contact Us
        </NavLink>

    </div>

    <div class="d-flex align-items-center ms-auto">

        <AuthorizeView>
            <Authorized>

                <div class="nav-item">
                    <NavLink class="nav-link fs-6 fw-semibold py-2 px-3 text-nowrap text-white"
                             href="Account/Manage">
                        <span class="bi bi-person-fill-nav-menu me-1" aria-hidden="true"></span>
                        @context.User.Identity?.Name
                    </NavLink>
                </div>

                <div class="nav-item">
                    <form action="Account/Logout" method="post" class="m-0">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="@currentUrl" />

                        <button type="submit"
                                class="nav-link btn btn-link fs-6 fw-semibold py-2 px-3 text-nowrap text-white">
                            <span class="bi bi-arrow-bar-left-nav-menu me-1" aria-hidden="true"></span>
                            Logout
                        </button>
                    </form>
                </div>

            </Authorized>

            <NotAuthorized>
                <div>
                    <NavLink class="nav-link fs-6 fw-semibold py-2 px-3 text-nowrap text-white d-inline-flex align-items-center"
                             href="Account/Register">
                        <span class="bi bi-person-nav-menu me-1" aria-hidden="true"></span>
                        Register
                    </NavLink>
                </div>

                <div>
                    <NavLink class="nav-link fs-6 fw-semibold py-2 px-3 text-nowrap text-white d-inline-flex align-items-center"
                             href="Account/Login">
                        <span class="bi bi-person-badge-nav-menu me-1" aria-hidden="true"></span>
                        Login
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</nav>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}